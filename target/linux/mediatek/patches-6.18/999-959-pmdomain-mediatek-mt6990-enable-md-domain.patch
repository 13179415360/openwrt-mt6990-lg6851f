+static int mt6990_md_is_on(struct scp_domain *scpd)
+{
+	return !!(readl(scpd->scp->base + MT6990_PWR_STATUS) & MT6990_MD_STA_MASK);
+}
+
+static int mt6990_md_bus_protect(struct scp *scp, bool enable)
+{
+	int ret;
+
+	ret = regmap_write(scp->infracfg,
+			enable ? MT6990_MD_PROT1_SET : MT6990_MD_PROT1_CLR,
+			MT6990_MD_PROT1_MASK);
+	if (ret)
+		return ret;
+	return regmap_write(scp->infracfg,
+			enable ? MT6990_MD_PROT2_SET : MT6990_MD_PROT2_CLR,
+			MT6990_MD_PROT2_MASK);
+}
+
+static int mt6990_md_power_on(struct generic_pm_domain *genpd)
+{
+	struct scp_domain *scpd = container_of(genpd, struct scp_domain, genpd);
+	struct scp *scp = scpd->scp;
+	void __iomem *ctl = scp->base + MT6990_MD_PWR_CON;
+	void __iomem *extb = scp->base + MT6990_MD_EXTB_ISO_CON;
+	u32 val;
+	int ret, state;
+
+	writel(readl(extb) & ~MT6990_MD_EXTB_ISO_MASK, extb);
+	val = readl(ctl) | PWR_RST_B_BIT;
+	writel(val, ctl);
+	writel(val | PWR_ON_BIT, ctl);
+	ret = readx_poll_timeout(mt6990_md_is_on, scpd, state, state,
+				 MTK_POLL_DELAY_US, MTK_POLL_TIMEOUT);
+	if (!ret)
+		ret = mt6990_md_bus_protect(scp, false);
+	if (ret) {
+		writel(readl(extb) | MT6990_MD_EXTB_ISO_MASK, extb);
+		dev_err(scp->dev, "MT6990 MD power-on failed: %d E00=%08x F30=%08x F38=%08x\n",
+			ret, readl(ctl), readl(extb), readl(scp->base + MT6990_PWR_STATUS));
+		return ret;
+	}
+	dev_info(scp->dev, "MT6990 MD on: E00=%08x F30=%08x F38=%08x F3C=%08x\n",
+		 readl(ctl), readl(extb), readl(scp->base + MT6990_PWR_STATUS),
+		 readl(scp->base + MT6990_PWR_STATUS_2ND));
+	return 0;
+}
+
+static int mt6990_md_power_off(struct generic_pm_domain *genpd)
+{
+	struct scp_domain *scpd = container_of(genpd, struct scp_domain, genpd);
+	struct scp *scp = scpd->scp;
+	void __iomem *ctl = scp->base + MT6990_MD_PWR_CON;
+	void __iomem *extb = scp->base + MT6990_MD_EXTB_ISO_CON;
+	int ret, state;
+
+	ret = mt6990_md_bus_protect(scp, true);
+	if (ret)
+		return ret;
+	writel(readl(ctl) & ~PWR_ON_BIT, ctl);
+	ret = readx_poll_timeout(mt6990_md_is_on, scpd, state, !state,
+				 MTK_POLL_DELAY_US, MTK_POLL_TIMEOUT);
+	if (ret)
+		return ret;
+	writel(readl(extb) | MT6990_MD_EXTB_ISO_MASK, extb);
+	writel(readl(ctl) & ~PWR_RST_B_BIT, ctl);
+	dev_info(scp->dev, "MT6990 MD off: E00=%08x F30=%08x F38=%08x F3C=%08x\n",
+		 readl(ctl), readl(extb), readl(scp->base + MT6990_PWR_STATUS),
+		 readl(scp->base + MT6990_PWR_STATUS_2ND));
+	return 0;
+}
