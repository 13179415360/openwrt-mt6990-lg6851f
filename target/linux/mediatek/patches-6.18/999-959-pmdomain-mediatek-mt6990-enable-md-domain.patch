+#define MT6990_MD_PWR_CON		0x0e00
+#define MT6990_MD_EXTB_ISO_CON		0x0f30
+#define MT6990_MD_EXTB_ISO_MASK		GENMASK(1, 0)
+#define MT6990_MD_STA_MASK		BIT(0)
+#define MT6990_MD_PROT1_SET		0x02a8
+#define MT6990_MD_PROT1_CLR		0x02ac
+#define MT6990_MD_PROT1_MASK		(BIT(22) | BIT(2))
+#define MT6990_MD_PROT2_SET		0x0714
+#define MT6990_MD_PROT2_CLR		0x0718
+#define MT6990_MD_PROT2_MASK		BIT(25)
