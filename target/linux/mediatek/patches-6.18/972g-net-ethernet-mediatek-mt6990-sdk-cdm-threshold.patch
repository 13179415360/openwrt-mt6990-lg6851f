From: OpenWrt MT6990 integration
Subject: [PATCH] net: ethernet: mediatek: set MT6990 SDK CDM threshold

The MT6990 NETSYS-v2 SDK programs CDMW0_THRES to 0x04000404.  Keep this
MT6990-specific instead of selecting a mainline MT79xx NETSYS capability,
which would also enable unrelated descriptor and register assumptions.

--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -4760,6 +4760,9 @@ static int mtk_hw_init(struct mtk_eth *eth)
 		mtk_w32(eth, 0, reg_map->pdma.int_grp + 8);
 		mtk_w32(eth, mtk_tx_done_mask(eth), reg_map->qdma.int_grp);
 		mtk_w32(eth, 0x01000000, MTK_FE_INT_GRP);
+
+		/* Exact CONFIG_MEDIATEK_NETSYS_V2 MT6990 SDK value. */
+		mtk_w32(eth, 0x04000404, MTK_CDMW0_THRES);
 	} else {
 		mtk_w32(eth, mtk_tx_done_mask(eth), reg_map->pdma.int_grp);
 		mtk_w32(eth, eth->soc->rx.irq_done_mask,
