+#define MT6990_NETSYS_PWR_CON		0x0e50
+#define MT6990_NETSYS_S_SRAM_CON	0x0f20
+#define MT6990_PWR_STATUS		0x0f38
+#define MT6990_PWR_STATUS_2ND		0x0f3c
+#define MT6990_NETSYS_STA_MASK		BIT(21)
+#define MT6990_NETSYS_PWR_SRAM_BIT	BIT(8)
+#define MT6990_NETSYS_CLK_NUM		5
+
 #define SPM_PWR_STATUS			0x060c
 #define SPM_PWR_STATUS_2ND		0x0610
 
@@ -153,6 +162,7 @@ struct scp {
 	struct device *dev;
 	void __iomem *base;
 	struct regmap *infracfg;
