 	MT6990_ALWAYS_ON_DOMAIN(MT6990_POWER_DOMAIN_HSM_TOP, "hsm_top"),
@@ -1110,6 +1266,10 @@ static const struct scp_domain_data scp_
 static const struct scp_soc_data mt6990_data = {
