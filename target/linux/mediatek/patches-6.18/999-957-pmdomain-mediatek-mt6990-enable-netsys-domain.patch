+				dev_err(&pdev->dev,
+					"MT6990 NETSYS: cannot get clock %s: %ld\n",
+					mt6990_netsys_clk_names[i],
+					PTR_ERR(scp->mt6990_netsys_clks[i]));
+				return ERR_CAST(scp->mt6990_netsys_clks[i]);
+			}
+		}
+	}
+
 	for (i = 0; i < num; i++) {
 		struct scp_domain *scpd = &scp->domains[i];
 		const struct scp_domain_data *data = &scp_domain_data[i];
@@ -523,7 +670,11 @@ static struct scp *init_scp(struct platf
 		}
 
 		genpd->name = data->name;
-		if (MTK_SCPD_CAPS(scpd, MTK_SCPD_ALWAYS_ON)) {
+		if (MTK_SCPD_CAPS(scpd, MTK_SCPD_MT6990_NETSYS)) {
+			genpd->power_off = scpsys_power_noop;
+			genpd->power_on = mt6990_netsys_power_on;
+			genpd->flags |= GENPD_FLAG_ALWAYS_ON;
+		} else if (MTK_SCPD_CAPS(scpd, MTK_SCPD_ALWAYS_ON)) {
 			genpd->power_off = scpsys_power_noop;
 			genpd->power_on = scpsys_power_noop;
 			genpd->flags |= GENPD_FLAG_ALWAYS_ON;
@@ -1092,7 +1243,12 @@ static const struct scp_domain_data scp_
 	MT6990_ALWAYS_ON_DOMAIN(MT6990_POWER_DOMAIN_MSDC, "msdc"),
 	MT6990_ALWAYS_ON_DOMAIN(MT6990_POWER_DOMAIN_ETH, "eth"),
 	MT6990_ALWAYS_ON_DOMAIN(MT6990_POWER_DOMAIN_MED, "medsys"),
-	MT6990_ALWAYS_ON_DOMAIN(MT6990_POWER_DOMAIN_NET, "netsys"),
+	[MT6990_POWER_DOMAIN_NET] = {
