@@ -365,6 +375,123 @@ static int scpsys_power_noop(struct gene
 	return 0;
 }
 
+
+struct mt6990_netsys_bus_prot {
+	u32 clr_ofs;
+	u32 mask;
+};
+
+static const char * const mt6990_netsys_clk_names[] = {
+	"netsys",
+	"wedsys",
+	"medsys",
+	"net500",
+	"net2x",
+};
+
+static const struct mt6990_netsys_bus_prot mt6990_netsys_bus_prot[] = {
+	{ 0x0b88, BIT(5) },
+	{ 0x0ba8, BIT(5) },
+	{ 0x0718, GENMASK(14, 9) },
+	{ 0x0b88, BIT(2) },
+	{ 0x0ba8, BIT(2) },
+	{ 0x02a4, BIT(8) },
+	{ 0x0718, BIT(28) },
+};
+
+static int mt6990_netsys_power_on(struct generic_pm_domain *genpd)
+{
+	struct scp_domain *scpd = container_of(genpd, struct scp_domain, genpd);
+	struct scp *scp = scpd->scp;
+	void __iomem *ctl_addr = scp->base + MT6990_NETSYS_PWR_CON;
+	void __iomem *sram_addr = scp->base + MT6990_NETSYS_S_SRAM_CON;
+	u32 val;
+	int i, ret, tmp;
+
+	ret = scpsys_clk_enable(scp->mt6990_netsys_clks,
+				MT6990_NETSYS_CLK_NUM);
+	if (ret) {
+		dev_err(scp->dev, "MT6990 NETSYS: failed to enable clocks: %d\n",
+			ret);
+		return ret;
+	}
+
+	val = readl(ctl_addr);
+	val |= PWR_ON_BIT;
+	writel(val, ctl_addr);
+
+	val |= PWR_ON_2ND_BIT;
+	writel(val, ctl_addr);
+
+	ret = readl_poll_timeout(scp->base + MT6990_PWR_STATUS, tmp,
+				 (tmp & MT6990_NETSYS_STA_MASK) ==
+				 MT6990_NETSYS_STA_MASK,
+				 MTK_POLL_DELAY_US, MTK_POLL_TIMEOUT);
+	if (ret)
+		goto err_disable_clks;
+
+	ret = readl_poll_timeout(scp->base + MT6990_PWR_STATUS_2ND, tmp,
+				 (tmp & MT6990_NETSYS_STA_MASK) ==
+				 MT6990_NETSYS_STA_MASK,
+				 MTK_POLL_DELAY_US, MTK_POLL_TIMEOUT);
+	if (ret)
+		goto err_disable_clks;
+
+	val = readl(ctl_addr);
+	val &= ~PWR_CLK_DIS_BIT;
+	writel(val, ctl_addr);
+
+	val &= ~PWR_ISO_BIT;
+	writel(val, ctl_addr);
+
+	val |= PWR_RST_B_BIT;
+	writel(val, ctl_addr);
+
+	val &= ~MT6990_NETSYS_PWR_SRAM_BIT;
+	writel(val, ctl_addr);
+
+	for (i = 0; i < 6; i++) {
+		u32 pdn = BIT(7 + i);
+		u32 ack = BIT(19 + i);
+
+		val = readl(sram_addr);
+		val &= ~pdn;
+		writel(val, sram_addr);
+
+		ret = readl_poll_timeout(sram_addr, tmp, !(tmp & ack),
+					 MTK_POLL_DELAY_US,
+					 MTK_POLL_TIMEOUT);
+		if (ret)
+			goto err_disable_clks;
+	}
+
+	for (i = ARRAY_SIZE(mt6990_netsys_bus_prot) - 1; i >= 0; i--) {
+		ret = regmap_write(scp->infracfg,
+				   mt6990_netsys_bus_prot[i].clr_ofs,
+				   mt6990_netsys_bus_prot[i].mask);
+		if (ret)
+			goto err_disable_clks;
+	}
+
+	dev_info(scp->dev,
+		 "MT6990 NETSYS on: E50=%08x F20=%08x F38=%08x F3C=%08x\n",
+		 readl(ctl_addr), readl(sram_addr),
+		 readl(scp->base + MT6990_PWR_STATUS),
+		 readl(scp->base + MT6990_PWR_STATUS_2ND));
+
+	return 0;
+
+err_disable_clks:
+	dev_err(scp->dev,
+		"MT6990 NETSYS power-on failed: ret=%d E50=%08x F20=%08x F38=%08x F3C=%08x\n",
+		ret, readl(ctl_addr), readl(sram_addr),
+		readl(scp->base + MT6990_PWR_STATUS),
+		readl(scp->base + MT6990_PWR_STATUS_2ND));
+	scpsys_clk_disable(scp->mt6990_netsys_clks,
+			   MT6990_NETSYS_CLK_NUM);
+	return ret;
+}
+
 static int scpsys_power_off(struct generic_pm_domain *genpd)
 {
