--- a/drivers/mmc/host/mtk-sd.c
+++ b/drivers/mmc/host/mtk-sd.c
@@ -660,6 +660,21 @@ static const struct mtk_mmc_compatible m
 	.support_64g = true,
 };
 
+/* MT6990 values from the vendor 5.15 SDK patch 1106. */
+static const struct mtk_mmc_compatible mt6990_compat = {
+	.clk_div_bits = 12,
+	.recheck_sdio_irq = false,
+	.hs400_tune = false,
+	.needs_top_base = true,
+	.pad_tune_reg = MSDC_PAD_TUNE0,
+	.async_fifo = true,
+	.data_tune = true,
+	.busy_check = true,
+	.stop_clk_fix = true,
+	.enhance_rx = true,
+	.support_64g = true,
+};
+
 static const struct mtk_mmc_compatible mt8516_compat = {
 	.clk_div_bits = 12,
 	.recheck_sdio_irq = true,
@@ -702,6 +716,7 @@ static const struct of_device_id msdc_of
 	{ .compatible = "mediatek,mt7622-mmc", .data = &mt7622_compat},
 	{ .compatible = "mediatek,mt7986-mmc", .data = &mt7986_compat},
 	{ .compatible = "mediatek,mt7988-mmc", .data = &mt7986_compat},
+	{ .compatible = "mediatek,mt6990-mmc", .data = &mt6990_compat},
 	{ .compatible = "mediatek,mt8135-mmc", .data = &mt8135_compat},
 	{ .compatible = "mediatek,mt8173-mmc", .data = &mt8173_compat},
 	{ .compatible = "mediatek,mt8183-mmc", .data = &mt8183_compat},
@@ -3042,6 +3057,12 @@ static int msdc_drv_probe(struct platform
 	mmc->caps |= MMC_CAP_CMD23;
 	mmc->caps2 |= MMC_CAP2_NO_PRESCAN_POWERUP;
 
+	/* The LG6851F board has fixed rails; preserve the MT6990 SDK OCR. */
+	if (of_device_is_compatible(pdev->dev.of_node,
+				    "mediatek,mt6990-mmc"))
+		mmc->ocr_avail = MMC_VDD_28_29 | MMC_VDD_29_30 |
+				 MMC_VDD_30_31;
+
 	ret = mmc_regulator_get_supply(mmc);
 	if (ret)
 		goto release_mem;
