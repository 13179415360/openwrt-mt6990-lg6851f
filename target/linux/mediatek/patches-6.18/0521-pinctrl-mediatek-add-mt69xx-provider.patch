From: LG6851F MT6990 bring-up
Subject: [PATCH] pinctrl: mediatek: add MT69xx pinctrl provider

Add MediaTek MT69xx pinctrl provider support for MT6990 platforms.
The provider matches compatible string "mediatek,mt69xx-pinctrl" used by MT6990 DTS.
Adapt the SDK 5.15 driver to the current 6.18 MediaTek Paris pinctrl API:
- PINCTRL_PIN_REG_RES_SEL -> PINCTRL_PIN_REG_RSEL
- PINCTRL_PIN_REG_DRV_EH -> PINCTRL_PIN_REG_DRV_E1
- pass SoC data through of_device_id .data
- call mtk_paris_pinctrl_probe(pdev)
- use pm_sleep_ptr(&mtk_paris_pinctrl_pm_ops)

--- a/drivers/pinctrl/mediatek/Kconfig
+++ b/drivers/pinctrl/mediatek/Kconfig
@@ -191,6 +191,16 @@ config PINCTRL_MT6893
 	  Say yes here to support pin controller and gpio driver
 	  on the MediaTek Dimensity 1200 MT6893 Smartphone SoC.
 
+
+config PINCTRL_MT69XX
+	bool "MediaTek MT69xx pin control"
+	depends on ARCH_MEDIATEK || COMPILE_TEST
+	depends on OF
+	select PINCTRL_MTK_PARIS
+	default y
+	help
+	  Support pinctrl and GPIO controller on MediaTek MT69xx platforms.
+
 config PINCTRL_MT7622
 	bool "MediaTek MT7622 pin control"
 	depends on OF
--- a/drivers/pinctrl/mediatek/Makefile
+++ b/drivers/pinctrl/mediatek/Makefile
@@ -42,3 +42,5 @@ obj-$(CONFIG_PINCTRL_MT8196)		+= pinctrl
 obj-$(CONFIG_PINCTRL_MT8365)		+= pinctrl-mt8365.o
 obj-$(CONFIG_PINCTRL_MT8516)		+= pinctrl-mt8516.o
 obj-$(CONFIG_PINCTRL_MT6397)		+= pinctrl-mt6397.o
+
+obj-$(CONFIG_PINCTRL_MT69XX)	+= pinctrl-mt69xx.o
--- /dev/null
+++ b/drivers/pinctrl/mediatek/pinctrl-mt69xx.c
@@ -0,0 +1,1071 @@
