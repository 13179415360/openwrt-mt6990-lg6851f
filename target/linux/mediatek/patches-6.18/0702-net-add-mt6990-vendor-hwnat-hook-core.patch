--- a/net/Kconfig
+++ b/net/Kconfig
@@ -467,6 +467,19 @@ config SOCK_VALIDATE_XMIT
 config NET_IEEE8021Q_HELPERS
 	bool
 
+config HW_NAT
+	bool "MediaTek vendor HW NAT hook support"
+	depends on ARCH_MEDIATEK
+	default n
+	help
+	  Build the stable hook ABI used by the MT6990 Ethernet, Wi-Fi and
+	  MED/CCMNI data paths.  The actual PPE provider remains a separately
+	  packaged module so it can be stopped and audited independently.
+
+config TUNNEL_FAST_PATH
+	bool "MediaTek vendor tunnel fast path support"
+	depends on HW_NAT
+
 config NET_SELFTESTS
 	def_tristate PHYLIB
 	depends on PHYLIB && INET
--- a/net/Makefile
+++ b/net/Makefile
@@ -58,6 +58,7 @@ obj-$(CONFIG_6LOWPAN)		+= 6lowpan/
 obj-$(CONFIG_IEEE802154)	+= ieee802154/
 obj-$(CONFIG_MAC802154)		+= mac802154/
+obj-$(CONFIG_HW_NAT)		+= nat/foe_hook/
 
 obj-$(CONFIG_SYSCTL)		+= sysctl_net.o
 obj-$(CONFIG_DNS_RESOLVER)	+= dns_resolver/
