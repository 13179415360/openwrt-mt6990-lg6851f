 	}
 
 	ssusb_check_clocks(ssusb, check_clk);
+
+	/*
+	 * The MT6990 board has no usable VBUS-valid pin in device mode.
+	 * Match the vendor MTU3 sequence selected by mediatek,force-vbus:
+	 * put every PHY into peripheral mode and make the device controller
+	 * see VBUS before mtu3_start() asserts the gadget pull-up.
+	 */
+	for (i = 0; i < ssusb->num_phys; i++) {
+		phy_set_mode(ssusb->phys[i], PHY_MODE_USB_DEVICE);
+	}
+
+	if (device_property_read_bool(ssusb->dev, "mediatek,force-vbus")) {
+		value = mtu3_readl(ssusb->ippc_base, SSUSB_U2_CTRL(0));
+		value &= ~SSUSB_U2_PORT_OTG_SEL;
+		mtu3_writel(ssusb->ippc_base, SSUSB_U2_CTRL(0), value);
+
+		mtu3_setbits(ssusb->mac_base, U3D_MISC_CTRL,
+			      VBUS_FRC_EN | VBUS_ON);
+	}
+}
+
+static void mt6990_clk_mgr_port_off(struct ssusb_mtk *ssusb)
+{
+	void __iomem *ibase = ssusb->ippc_base;
+	u32 value;
+	unsigned int i;
+
+	dev_info(ssusb->dev, "clk-mgr port off\n");
+	synchronize_irq(ssusb->u3d->irq);
+	mtu3_setbits(ibase, SSUSB_U3_CTRL(0),
+		      SSUSB_U3_PORT_PDN | SSUSB_U3_PORT_DIS);
+	mtu3_clrbits(ibase, SSUSB_U3_CTRL(0), SSUSB_U3_PORT_DUAL_MODE);
+	mtu3_setbits(ibase, SSUSB_U2_CTRL(0),
+		      SSUSB_U2_PORT_PDN | SSUSB_U2_PORT_DIS);
+	mtu3_clrbits(ibase, SSUSB_U2_CTRL(0), SSUSB_U2_PORT_OTG_SEL);
+	mtu3_setbits(ibase, U3D_SSUSB_IP_PW_CTRL2, SSUSB_IP_DEV_PDN);
+	mtu3_setbits(ibase, U3D_SSUSB_IP_PW_CTRL1, SSUSB_IP_HOST_PDN);
+	readl_poll_timeout(ibase + U3D_SSUSB_IP_PW_STS1, value,
+			   value & SSUSB_IP_SLEEP_STS, 100, 100000);
+	for (i = 0; i < ssusb->num_phys; i++) {
+		phy_set_mode(ssusb->phys[i], PHY_MODE_INVALID);
+		phy_power_off(ssusb->phys[i]);
+	}
+	clk_bulk_disable_unprepare(BULK_CLKS_CNT, ssusb->clks);
+}
+
+static int mt6990_clk_mgr_device_on(struct ssusb_mtk *ssusb)
+{
+	unsigned int i;
+	int ret;
+
+	dev_info(ssusb->dev, "clk-mgr port on (%d)\n", PHY_MODE_USB_DEVICE);
+	ret = clk_bulk_prepare_enable(BULK_CLKS_CNT, ssusb->clks);
+	if (ret)
+		return ret;
+	for (i = 0; i < ssusb->num_phys; i++) {
+		ret = phy_power_on(ssusb->phys[i]);
+		if (ret)
+			return ret;
+		phy_set_mode(ssusb->phys[i], PHY_MODE_USB_DEVICE);
+	}
+	mtu3_setbits(ssusb->ippc_base, U3D_SSUSB_IP_PW_CTRL0,
+		      SSUSB_IP_SW_RST);
+	udelay(1);
+	mtu3_clrbits(ssusb->ippc_base, U3D_SSUSB_IP_PW_CTRL0,
+		      SSUSB_IP_SW_RST);
+	return mtu3_device_enable(ssusb->u3d);
 }
 
