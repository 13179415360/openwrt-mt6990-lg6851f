From: OpenWrt MT6990 repair <local@mt6990>\nSubject: [PATCH] usb: mtu3: add MT6990 CPE gadget compatibility\n\nRestore the vendor PHY power sequence, clock-managed role transition,\nforced VBUS handling and original QMU GPD layout required by LG6851F.\nAll non-generic behavior is selected explicitly through DT properties.\n\n--- a/drivers/usb/mtu3/mtu3_core.c
+++ b/drivers/usb/mtu3/mtu3_core.c
@@ -93,7 +93,7 @@
 }
 
 /* only port0 of U2/U3 supports device mode */
-static int mtu3_device_enable(struct mtu3 *mtu)
+int mtu3_device_enable(struct mtu3 *mtu)
 {
 	void __iomem *ibase = mtu->ippc_base;
 	u32 check_clk = 0;
@@ -859,6 +859,15 @@
 	value = mtu3_readl(mtu->ippc_base, U3D_SSUSB_IP_TRUNK_VERS);
 	mtu->hw_version = IP_TRUNK_VERS(value);
 	mtu->gen2cp = !!(mtu->hw_version >= MTU3_TRUNK_VERS_1003);
+	/* Some MT6990 CPE variants report trunk 0x1007 but retain the
+	 * original QMU GPD layout.  The extended layout makes a 24-byte RX
+	 * buffer look like one byte to hardware and breaks ADB's CNXN packet.
+	 */
+	if (device_property_read_bool(mtu->dev,
+				      "mediatek,original-qmu-gpd")) {
+		mtu->gen2cp = false;
+		dev_info(mtu->dev, "use original QMU GPD format\n");
+	}
 
	value = mtu3_readl(mtu->ippc_base, U3D_SSUSB_IP_DEV_CAP);
	mtu->u3_capable = !!SSUSB_IP_DEV_U3_PORT_NUM(value);
