config main 'main'
	option enabled '1'
	# Follow this logical interface's current l3_device across modem redials.
	option network_interface 'modem5g'
	option ifb_device 'ifb-cellular'
	option max_hosts '36'
	option overhead '44'
	option diffserv 'diffserv4'
	# Autorate startup seed, not a ceiling.  It prevents a cold boot with only
	# sparse background packets from beginning at dial-up speed.
	option ingress_seed '1gbit'
