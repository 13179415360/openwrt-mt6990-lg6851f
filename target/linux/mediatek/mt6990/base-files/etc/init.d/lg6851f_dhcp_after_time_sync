#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
# Keep volatile DHCP leases coherent across the first wall-clock correction.

START=96
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c '
		start_wall=$(date +%s)
		start_up=${SECONDS:-0}
		[ -r /proc/uptime ] && read start_up _ </proc/uptime
		start_up=${start_up%%.*}
		i=0
		while [ "$i" -lt 120 ]; do
			now=$(date +%s)
			up=${SECONDS:-0}
			[ -r /proc/uptime ] && read up _ </proc/uptime
			up=${up%%.*}
			expected=$((start_wall + up - start_up))
			offset=$((now - expected))
			drift=$offset
			[ "$drift" -lt 0 ] && drift=$((-drift))
			stale_v4=0
			stale_v6=0
			[ -s /tmp/dhcp.leases ] && awk -v now="$now" "
				NF >= 5 && \$1 ~ /^[0-9]+\$/ && \$1 < now - 300 { found=1 }
				END { exit !found }
			" /tmp/dhcp.leases && stale_v4=1
			[ -s /tmp/odhcpd.leases ] && awk -v now="$now" "
				\$1 == \"#\" && NF >= 8 && \$6 ~ /^[0-9]+\$/ && \$6 < now - 300 { found=1 }
				END { exit !found }
			" /tmp/odhcpd.leases && stale_v6=1

			if [ "$drift" -gt 300 ] || [ "$stale_v4" -eq 1 ] || [ "$stale_v6" -eq 1 ]; then
				logger -t lg6851f-dhcp "repairing leases: wall offset=${offset}s stale_v4=${stale_v4} stale_v6=${stale_v6}"
				if [ -s /tmp/dhcp.leases ]; then
					awk -v delta="$offset" -v now="$now" "
						NF >= 5 && \$1 ~ /^[0-9]+\$/ {
							if (delta != 0) \$1 += delta
							if (\$1 <= now) \$1 = now + 3600
						}
						{ print }
					" /tmp/dhcp.leases > /tmp/dhcp.leases.shifted &&
						mv -f /tmp/dhcp.leases.shifted /tmp/dhcp.leases &&
						/etc/init.d/dnsmasq restart
				fi
				# odhcpd stores the absolute expiry epoch in field 6 of its
				# Hash-prefixed iface/duid/iaid/hostname/expiry lease records.
				# live UBUS lifetime is monotonic, but rpcd/LuCI reads this file;
				# after the RTC-less boot clock jumps forward, an unshifted file
				# therefore makes an active DHCPv6 lease appear expired.
				if [ -s /tmp/odhcpd.leases ]; then
					awk -v delta="$offset" -v now="$now" "
						\$1 == \"#\" && NF >= 8 && \$6 ~ /^[0-9]+\$/ {
							if (delta != 0) \$6 += delta
							if (\$6 <= now) \$6 = now + 3600
						}
						{ print }
					" /tmp/odhcpd.leases > /tmp/odhcpd.leases.shifted &&
						mv -f /tmp/odhcpd.leases.shifted /tmp/odhcpd.leases &&
						/etc/init.d/odhcpd restart
				fi
				exit 0
			fi
			i=$((i + 1))
			sleep 5
		done
	'
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
