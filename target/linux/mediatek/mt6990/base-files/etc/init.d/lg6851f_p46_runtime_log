START=20
STOP=88
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/lg6851f-p46-runtime-log
	procd_set_param respawn 30 5 5
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
