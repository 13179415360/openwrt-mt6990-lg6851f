#!/bin/sh /etc/rc.common

START=97
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /bin/sh -c 'while :; do /usr/sbin/lg6851f-fair-qos start >/dev/null 2>&1 && sleep 30 || sleep 3; done'
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	/usr/sbin/lg6851f-fair-qos apply
}

stop_service() {
	/usr/sbin/lg6851f-fair-qos stop
}

service_triggers() {
	procd_add_reload_trigger lg6851f_fair_qos network
}
