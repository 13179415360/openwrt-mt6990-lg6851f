#!/bin/sh

# LG6851F/MT6990 uses a locally maintained target, kernel ABI and Cortex-A55
# package ABI. Never mix it with rolling OpenWrt snapshot repositories.

arch_file=/etc/apk/arch
dist_file=/etc/apk/repositories.d/distfeeds.list
compat_file=/etc/apk/repositories.d/lg6851f-userland.list
custom_file=/etc/apk/repositories.d/customfeeds.list
# jsDelivr is used because GitHub Raw is unreliable on some cellular routes.
feed_root=https://cdn.jsdelivr.net/gh/13179415360/openwrt-mt6990-lg6851f@apk-feed-6.18.44

if [ -f "$arch_file" ]; then
	sed -i '/^aarch64_cortex-a53$/d' "$arch_file"
fi
grep -qxF 'aarch64_cortex-a55_neon-vfpv4' "$arch_file" 2>/dev/null || \
	echo 'aarch64_cortex-a55_neon-vfpv4' >> "$arch_file"

cat > "$dist_file" <<EOF
# LG6851F/MT6990 exclusive signed feeds.
# Linux 6.18.44; aarch64_cortex-a55_neon-vfpv4.
$feed_root/target/packages.adb
$feed_root/base/packages.adb
$feed_root/luci/packages.adb
$feed_root/packages/packages.adb
EOF

rm -f "$compat_file"

if [ -s "$custom_file" ] && grep -qvE '^[[:space:]]*(#|$)' "$custom_file"; then
	cp "$custom_file" /etc/apk/customfeeds.disabled-by-mt6990-safety 2>/dev/null || true
fi
cat > "$custom_file" <<'EOF'
# Disabled: LG6851F/MT6990 accepts only its dedicated signed feed.
EOF

# Fail closed if somebody accidentally adds an official/generic repository.
rm -f /etc/apk/keys/openwrt-snapshots.pem

exit 0
