			polling-delay = <0x3e8>;
			polling-delay-passive = <0x3e8>;
			thermal-sensors = <0x36>;

			trips {

				soc_dram_ntc_crit@0 {
					temperature = <0x19a28>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0xe2>;
				};
			};
		};

		nrpa_ntc {
			polling-delay = <0x3e8>;
