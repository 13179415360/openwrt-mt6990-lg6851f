	/*
	 * LG6851F has two production fan variants selected by the stock GPIO193
	 * strap.  A high strap is the four-wire assembly on PWM0/GPIO124 with
	 * GPIO121 tachometer feedback.  Its circuit is inverted: PWM100 gives
	 * about 2310 RPM while PWM255 nearly stops it.
	 */
	soc_fan: pwm-fan {
		compatible = "pwm-fan";
		pwms = <0xb2 0 40000>;
		/* Stock tachometer: GPIO121, falling edge, two pulses/revolution. */
		interrupt-parent = <&pio>;
		interrupts = <121 2>;
		pulses-per-revolution = <2>;
		/* GPIO107 gates the fitted fan supply on some production batches. */
		fan-supply = <&fan_power>;
		pinctrl-names = "default";
		pinctrl-0 = <&fan_pwm0_pin_default &pwm_decode_pin_default>;
		#cooling-cells = <2>;
		/* Boot at the proven standard speed; userspace applies the curve. */
		cooling-levels = <100 100 100 100 100 100 100>;
		status = "okay";
	};

	/*
	 * A low GPIO193 strap is the three-wire assembly on PWM5/GPIO122.  The
	 * userspace controller applies its verified 10 kHz fine settings through
	 * the MT69xx PWM registers (thresholds 8/10/12); this node safely claims
	 * the pin and supplies the initial hardware state.
	 */
	aux_fan: pwm-fan-aux {
		compatible = "pwm-fan";
		pwms = <0xb2 5 20000>;
		fan-supply = <&fan_power>;
		pinctrl-names = "default";
		pinctrl-0 = <&fan_pwm5_pin_default>;
		#cooling-cells = <2>;
		cooling-levels = <100 100 100 100 100 100 100>;
		status = "okay";
	};

};

/ {
	lg6851f_dts_path_verify = "lg6851f-openwrt-main-dts-path-verify-20260709_181442";
	lg6851f_dts_path_verify_file = "/home/zjl-pc/openwrt/target/linux/mediatek/dts/mt6990-fiberhome-lg6851f.dts";

	/* Stock oem_fan_init: GPIO107 mode 0, output high, then enable PWM. */
	fan_power: regulator-fan-power {
		compatible = "regulator-fixed";
		regulator-name = "lg6851f-fan-power";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&pio 107 0>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	reg_emmc_vcc: regulator-emmc-vcc {
		compatible = "regulator-fixed";
		regulator-name = "emmc_vcc";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	reg_emmc_vqmmc: regulator-emmc-vqmmc {
		compatible = "regulator-fixed";
		regulator-name = "emmc_vqmmc";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		regulator-always-on;
		regulator-boot-on;
	};

	/* MT6990_OPENWRT_REAL_MMC0_ROOTFS_BEGIN */
	mmc0: mmc@11230000 {
		compatible = "mediatek,mt6990-mmc";
		reg = <0x00 0x11230000 0x00 0x1000>,
		      <0x00 0x11f00000 0x00 0x1000>;
		interrupts = <0x00 0x104 0x04>;

		clocks = <0x2b CLK_PERAO_MSDC50_SCAN>,
			 <0x2b CLK_PERAO_MSDC50_HCLK>,
			 <0x2b CLK_PERAO_MSDC0_AXI_MASTER>,
			 <0x2b CLK_PERAO_MSDC0_AHB_SLAVE>;
		clock-names = "source", "hclk", "axi_cg", "ahb_cg";

		pinctrl-names = "default", "state_uhs";
		pinctrl-0 = <0x65>;
		pinctrl-1 = <0x66>;

		vmmc-supply = <&reg_emmc_vcc>;
		vqmmc-supply = <&reg_emmc_vqmmc>;
		voltage-ranges = <2700 3600>;

		bus-width = <8>;
		max-frequency = <200000000>;
		cap-mmc-highspeed;
		mmc-ddr-1_8v;
		mmc-hs200-1_8v;
		mmc-hs400-1_8v;
		cap-mmc-hw-reset;
		hs400-ds-delay = <0x12814>;
		supports-cqe;
		non-removable;
		no-sd;
		no-sdio;
		status = "okay";
	};

	mmc1: mmc@11240000 {
		compatible = "mediatek,mt6990-mmc";
		reg = <0x00 0x11240000 0x00 0x1000>,
		      <0x00 0x11d60000 0x00 0x1000>;
		interrupts = <0x00 0x105 0x04>;
		clocks = <&clk26m>, <&clk26m>;
		clock-names = "source", "hclk";
		status = "disabled";
	};
	/* MT6990_OPENWRT_REAL_MMC0_ROOTFS_END */
};
