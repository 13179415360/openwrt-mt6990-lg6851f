	/* MT6990 SGMIISYS PCS syscons; names and addresses match the stock DT. */
	sgmiisys0: sgmiisys@11304000 {
		compatible = "mediatek,mt6990-sgmiisys", "mediatek,colgin-sgmiisys_0", "syscon";
		reg = <0x00 0x11304000 0x00 0x1000>;
		#clock-cells = <0x01>;
		mediatek,physpeed = "2500";
		phys = <&sgmii_phy0>;
		phy-names = "sgmii";
		phandle = <0x6b>;
	};

	sgmiisys1: sgmiisys@11305000 {
		compatible = "mediatek,mt6990-sgmiisys", "mediatek,colgin-sgmiisys_1", "syscon";
		reg = <0x00 0x11305000 0x00 0x1000>;
		#clock-cells = <0x01>;
		mediatek,physpeed = "2500";
		phys = <&sgmii_phy1>;
		phy-names = "sgmii";
		phandle = <0x6c>;
	};

	sgmii_phy0: phy@11e50000 {
		compatible = "mediatek,mt6990-sgmii-phy";
		reg = <0x00 0x11e50000 0x00 0x10000>;
		power-domains = <&scpsys MT6990_POWER_DOMAIN_SGMII_TOP_0>;
		power-domain-names = "sgmii-top";
		mediatek,sgmii-pll = <&sgmiipll>;
		mediatek,spm = <&scpsys>;
		mediatek,sgmii-id = <0>;
		#phy-cells = <0>;
	};

	sgmii_phy1: phy@11e60000 {
		compatible = "mediatek,mt6990-sgmii-phy";
		reg = <0x00 0x11e60000 0x00 0x10000>;
		power-domains = <&scpsys MT6990_POWER_DOMAIN_SGMII_TOP_1>;
		power-domain-names = "sgmii-top";
		mediatek,sgmii-pll = <&sgmiipll>;
		mediatek,spm = <&scpsys>;
		mediatek,sgmii-id = <1>;
		#phy-cells = <0>;
	};

	sgmiipll: sgmiipll@10014000 {
		compatible = "mediatek,colgin-sgmiisys_pll", "syscon";
		reg = <0x00 0x10014000 0x00 0x1000>;
	};

	/* stock boot DTB lines 4326-4335: serial@11004000 */
	serial@11004000 {
