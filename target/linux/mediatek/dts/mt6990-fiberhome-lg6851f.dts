	/* stock boot DTB lines 1087-1375: thermal-zones */
	thermal-zones {

		soc_max {
			polling-delay = <0x64>;
			polling-delay-passive = <0x32>;
			thermal-sensors = <0x32 0x00>;

			trips {
				fan_low: fan-low {
					temperature = <45000>;
					hysteresis = <3000>;
					type = "active";
				};

				fan_medium: fan-medium {
					temperature = <60000>;
					hysteresis = <3000>;
					type = "active";
				};

				fan_high: fan-high {
					temperature = <75000>;
					hysteresis = <3000>;
					type = "active";
				};

				fan_full: fan-full {
					temperature = <85000>;
					hysteresis = <3000>;
					type = "active";
				};

				cpu_trip-point@0 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x33>;
				};

				gpu_trip-point@0 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x34>;
				};

				soc_max_crit@0 {
					temperature = <0x1c138>;
					hysteresis = <0x7d0>;
					type = "critical";
					phandle = <0xe1>;
				};
			};

			cooling-maps {
				/*
				 * Fan policy is owned by lg6851f-fan-control because PWM0/PWM5
				 * routing and polarity vary between production batches.  Do not
				 * bind soc_fan here: once LVTS is active, the thermal governor
				 * would otherwise overwrite the userspace curve every 100 ms.
				 * CPU/GPU throttling and the critical shutdown trip remain below.
				 */
				map0 {
					trip = <0x33>;
					cooling-device = <0x0b 0xffffffff 0xffffffff 0x0c 0xffffffff 0xffffffff 0x0d 0xffffffff 0xffffffff 0x0e 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};

				map1 {
					trip = <0x34>;
					cooling-device = <0x35 0xffffffff 0xffffffff>;
					contribution = <0x400>;
				};
			};
		};

		cpu_little0 {
			polling-delay = <0x00>;
			polling-delay-passive = <0x00>;
			thermal-sensors = <0x32 0x01>;
		};

