		mediatek,mt6990-power-sequence;
		reg = <0x00 0x11ec3000 0x00 0x200>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x151>;

		usb2-phy0@11ec0000 {
			reg = <0x00 0x11ec0000 0x00 0x400>;
			clocks = <0x46>;
			clock-names = "ref";
			#phy-cells = <0x01>;
			mediatek,efuse-u2-intr-cal = <0x23>;
			mediatek,efuse-u2-term-cal = <0x08>;
			mediatek,eye-vrt = <0x02>;
			mediatek,eye-vrt-host = <0x02>;
			mediatek,discth = <0x09>;
			mediatek,rev6 = <0x01>;
			mediatek,sqth = <0x05>;
			nvmem-cells = <0x62>;
			nvmem-cell-names = "u2_efuse_data";
			phandle = <0x5e>;
		};

		usb3-phy0@11ec3000 {
			reg = <0x00 0x11ec3400 0x00 0x500>;
			clocks = <0x46>;
			clock-names = "ref";
			#phy-cells = <0x01>;
			nvmem-cells = <0x63>;
			nvmem-cell-names = "u3_efuse_data";
			phandle = <0x5f>;
		};
	};

	/* stock boot DTB lines 4277-4286: dma-controller@11300000 */
	dma-controller@11300000 {
