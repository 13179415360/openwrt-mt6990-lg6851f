		reg = <0x00 0x11300400 0x00 0x80 0x00 0x11300480 0x00 0x80 0x00 0x11300500 0x00 0x80 0x00 0x11300580 0x00 0x80 0x00 0x11300600 0x00 0x80 0x00 0x11300680 0x00 0x80>;
		interrupts = <0x00 0xf4 0x04 0x00 0xf5 0x04 0x00 0xf6 0x04 0x00 0xf7 0x04 0x00 0xf8 0x04 0x00 0xf9 0x04>;
		dma-requests = <0x06>;
