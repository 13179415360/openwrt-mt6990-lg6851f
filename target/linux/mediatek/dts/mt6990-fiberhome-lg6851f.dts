/* stock boot DTB lines 4501-4516: ethsys@15000000 */
	ethsys@15000000 {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "mediatek,leopard-ethsys\0syscon\0simple-mfd";
		reg = <0x00 0x15000000 0x00 0x1000>;
		#clock-cells = <0x01>;
		#reset-cells = <0x01>;
		phandle = <0x6a>;

		reset-controller {
			compatible = "ti,syscon-reset";
			#reset-cells = <0x01>;
			ti,reset-bits = <0x34 0x04 0x34 0x04 0x34 0x04 0x28>;
			phandle = <0x22>;
		};
	};

	/* stock boot DTB lines 4518-4522: hnat@15102200 */
	hnat@15102200 {
		compatible = "mediatek,hnat\0syscon";
		reg = <0x00 0x15102200 0x00 0x1000>;
		phandle = <0x159>;
	};

	/* stock boot DTB lines 4524-4586: netsys@15100000 */
	netsys@15100000 {
		compatible = "mediatek,mt6990-netsys";
		reg = <0x00 0x15100000 0x00 0x20000>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		interrupts-extended = <0x01 0x00 0x1ac 0x04 0x01 0x00 0x1b0 0x04 0x01 0x00 0x1b4 0x04 0x01 0x00 0x1ad 0x04 0x01 0x00 0x1b1 0x04 0x01 0x00 0x1b5 0x04 0x01 0x00 0x1ae 0x04 0x01 0x00 0x1b2 0x04 0x01 0x00 0x1b6 0x04>;
		interrupt-names = "netsys-edma0\0netsys-edma1\0netsys-edma2\0netsys-edma0-g1\0netsys-edma1-g1\0netsys-edma2-g1\0netsys-edma0-r1\0netsys-edma1-r1\0netsys-edma2-r1";
		clocks = <0x24 0x2a 0x24 0x29 0x24 0x2d 0x24 0x2c 0x24 0x2b>;
		clock-names = "net_sel\0net_500_sel\0med_mcu_sel\0wed_mcu_sel\0net_2x_sel";
		power-domains = <0x23 0x09>;
		ranges;
	};

	ethernet@15100000 {
		compatible = "mediatek,mt6990-eth", "syscon";

		reg = <0x00 0x15100000 0x00 0x30000>;
		interrupts-extended = <0x01 0x00 0x197 0x04 0x01 0x00 0x198 0x04 0x01 0x00 0x190 0x04 0x01 0x00 0x191 0x04 0x01 0x00 0x192 0x04 0x01 0x00 0x193 0x04 0x05 0x32 0x02 0x05 0x34 0x02>;
		interrupt-names = "fe-reserved", "fe1", "fe2", "fe-rx1",
				  "fe-rx2", "fe-rx3", "phy0", "phy1";
		clocks = <0x24 0x2e 0x24 0x2f 0x24 0x30 0x24 0x31 0x24 0x32 0x24 0x33>;
		clock-names = "sgmii_0_sel",
			      "sgmii_sbus_0_sel",
			      "sgmii_1_sel",
			      "sgmii_sbus_1_sel",
			      "usxgmii_sbus_0_sel",
			      "usxgmii_sbus_1_sel";
		mediatek,infracfg = <0x25>;
		mediatek,ethsys = <0x6a>;
		mediatek,sgmiisys = <&sgmiisys0>, <&sgmiisys1>;
		mediatek,sgmii_pll = <&sgmiipll>;
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		status = "okay";
		pinctrl-names = "eth_gpio_default\0eth_smi_mdio_pinctl\0eth_smi_mdc_pinctl";
		pinctrl-0 = <0x72>;
		pinctrl-1 = <0x73>;
		pinctrl-2 = <0x74>;
		phandle = <0x15a>;

		gmac0: mac@0 {
			compatible = "mediatek,eth-mac";
			reg = <0x00>;
			phy-mode = "2500base-x";
			phandle = <0x15b>;

			fixed-link {
				speed = <2500>;
				full-duplex;
				pause;
			};
		};

		gmac1: mac@1 {
			compatible = "mediatek,eth-mac";
			reg = <0x01>;
			phy-mode = "2500base-x";
			phandle = <0x15c>;

			fixed-link {
				speed = <2500>;
				full-duplex;
				pause;
			};
		};

		mdio-bus {
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			phandle = <0xb1>;
		};
	}
;

