#include <dt-bindings/power/mt6990-power.h>
#include <dt-bindings/clock/mt6990-clk.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
// SPDX-License-Identifier: GPL-2.0-or-later OR MIT
/*
 * LG6851F Stage6O v3 generated board DTS.
 *
 * Baseline: original device boot_b DTB.
 * Purpose: preserve LK/bootloader-required MT6990 DT topology and phandle
 *          relationships instead of importing isolated nodes one by one.
 *
 * Scope:
 *   DTS source only. No rootfs/vendor userspace material is copied.
 */

/dts-v1/;

/ {
	model = "FiberHome Pro LG6851F";
	compatible = "fiberhome,lg6851f\0mediatek,mt6990";
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;

	dpmaif@0x10011000 {
		compatible = "mediatek,dpmaif";
		reg = <0x00 0x10011000 0x00 0x1000 0x00 0x1022d000 0x00 0x1000 0x00 0x1022c000 0x00 0x1000 0x00 0x1022e000 0x00 0x1000 0x00 0x15b14000 0x00 0x1000 0x00 0x15b38000 0x00 0x1000 0x00 0x15b13000 0x00 0x1000>;
		interrupts = <0x00 0xd1 0x04 0x00 0x1c8 0x04>;
		mediatek,dpmaif_capability = <0x06>;
		clocks = <0x25 0x02 0x25 0x10>;
		clock-names = "infra-dpmaif-clk\0infra-dpmaif-rg-mmw-clk";
		phandle = <0x137>;
	};

	phy1@0x11e00000 {
		compatible = "mediatek,mt6980-pcie-phy";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		#phy-cells = <0x00>;
		reg = <0x00 0x11e00000 0x00 0x10000>;
		reg-names = "sif";
		phy-id = <0x01>;
		status = "okay";
		power-domains = <0x23 0x0d>;
		phandle = <0x7a>;
	};

	phy2@0x11e20000 {
		compatible = "mediatek,mt6980-pcie-phy";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		#phy-cells = <0x00>;
		reg = <0x00 0x11e20000 0x00 0x10000>;
		reg-names = "sif";
		phy-id = <0x02>;
		status = "okay";
		power-domains = <0x23 0x0e>;
		phandle = <0x7f>;
	};

	iocfg_rt8@0x11c00000 {
		reg = <0x00 0x11c00000 0x00 0x1000>;
		phandle = <0x164>;
	};

	iocfg_rt9@0x11c10000 {
		reg = <0x00 0x11c10000 0x00 0x1000>;
		phandle = <0x165>;
	};

	nli_arb@0x11f50000 {
		reg = <0x00 0x11f50000 0x00 0x1000>;
		phandle = <0x166>;
	};

	/* stock boot DTB lines 10-13: chosen */
	chosen {
		bootargs = "console=tty0 console=ttyS0,921600n1 \t\tinit=/etc/preinit root=/dev/mmcblk0p39 rootwait \t\tloglevel=8 \t\tandroidboot.selinux=permissive androidboot.hardware=mt6990 \t\tinitcall_debug=1 page_owner=on \t\tmtk_printk_ctrl.disable_uart=0 \t\tclk_ignore_unused fw_devlink=off deferred_probe_timeout=10 ignore_loglevel \t\tpci=pcie_bus_safe \t\tpage_owner=on ramoops.mem_address=0x9c100000 ramoops.mem_size=0xe0000 ramoops.record_size=0x1000 ramoops.pmsg_size=0x10000 ramoops.console_size=0x40000 ramoops.ftrace_size=0x1000";
		phandle = <0xb4>;
	};

	/* stock boot DTB lines 15-27: srclken-rc@1200d000 */
	srclken-rc@1200d000 {
		compatible = "mediatek,srclken-rc";
		reg = <0x00 0x1200d000 0x00 0x100 0x00 0x1200d100 0x00 0x700>;
		mediatek,subsys-ctl = "suspend\0md1\0md2\0md3\0rf\0mmwave\0gps\0bt\0wifi\0conn_mcu\0co-ant\0nfc\0rsv\0ufs";
		suspend-ctl = "XO_BBCK1";
		md1-ctl = "XO_RFCK2A";
		mmw-ctl = "XO_RFCK1A";
		gps-ctl = "XO_RFCK2B";
		mcu-ctl = "XO_BBCK2";
		mediatek,srclken-rc-broadcast;
		mediatek,enable;
		phandle = <0x03>;
	};

	/* stock boot DTB lines 29-38: clock_buffer_ctrl */
	clock_buffer_ctrl {
		compatible = "mediatek,clock_buffer_ctrl";
		mediatek,xo-buf-hwbblpm-mask = <0x01 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		mediatek,xo-buf-hwbblpm-bypass = <0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00 0x00>;
		mediatek,enable;
		pmif = <0x02 0x00>;
		srclken_rc = <0x03>;
		consys = <0x04>;
		phandle = <0x55>;
	};

	/* stock boot DTB lines 40-43: psci */
	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	/* stock boot DTB lines 45-75: gpio_leds */
	gpio_leds {
		compatible = "gpio-leds";

		led0 {
			label = "5g_evb_sim";
			gpios = <0x05 0x12 0x00>;
			linux,default-trigger = "none";
			default-state = "off";
		};

		led1 {
			label = "5g_evb_voice";
			gpios = <0x05 0x10 0x00>;
			linux,default-trigger = "none";
			default-state = "off";
		};

		led2 {
			label = "5g_evb_wifi_mesh";
			gpios = <0x05 0x13 0x00>;
			linux,default-trigger = "none";
			default-state = "off";
		};

		led3 {
			label = "5g_evb_net_mode";
			gpios = <0x05 0x04 0x00>;
			linux,default-trigger = "none";
			default-state = "off";
		};

		/* LG6851F front-panel LEDs, physically verified on the product board.
		 * Old kernel global GPIOs 467/470-475 map to gpiochip offsets
		 * 191/194-199.  All seven channels are active high. */
		panel_wifi {
			label = "lg6851f:wifi";
			gpios = <&pio 191 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "none";
			default-state = "off";
		};

		panel_4g_good {
			label = "lg6851f:4g-good";
			gpios = <&pio 194 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "none";
			default-state = "off";
		};

		panel_4g_fair {
			label = "lg6851f:4g-fair";
			gpios = <&pio 195 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "none";
			default-state = "off";
		};

		panel_4g_bad {
			label = "lg6851f:4g-bad";
			gpios = <&pio 196 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "none";
			default-state = "off";
		};

		panel_5g_bad {
			label = "lg6851f:5g-bad";
			gpios = <&pio 197 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "none";
			default-state = "off";
		};

		panel_5g_fair {
			label = "lg6851f:5g-fair";
			gpios = <&pio 198 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "none";
			default-state = "off";
		};

		panel_5g_good {
			label = "lg6851f:5g-good";
			gpios = <&pio 199 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "none";
			default-state = "off";
		};
	};

	/* stock boot DTB lines 77-86: pwmleds */
	pwmleds {
		compatible = "mediatek,pwm-leds";

		backlight {
			label = "lcd-backlight";
			pwms = <0x06 0x00 0x99d9>;
			max-brightness = <0xff>;
			pwm-names = "lcd-backlight";
		};
	};

	/* stock boot DTB lines 88-195: cpus */
	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x00>;
			enable-method = "psci";
			performance-domains = <0x07 0x00>;
			clock-frequency = <0x65633340>;
			cpu-idle-states = <0x08 0x09 0x0a>;
			#cooling-cells = <0x02>;
			phandle = <0x0b>;
		};

		cpu@001 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x100>;
			enable-method = "psci";
			performance-domains = <0x07 0x00>;
			clock-frequency = <0x65633340>;
			cpu-idle-states = <0x08 0x09 0x0a>;
			#cooling-cells = <0x02>;
			phandle = <0x0c>;
		};

		cpu@002 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x200>;
			enable-method = "psci";
			performance-domains = <0x07 0x00>;
			clock-frequency = <0x65633340>;
			cpu-idle-states = <0x08 0x09 0x0a>;
			#cooling-cells = <0x02>;
			phandle = <0x0d>;
		};

		cpu@003 {
			device_type = "cpu";
			compatible = "arm,cortex-a55";
			reg = <0x300>;
			enable-method = "psci";
			performance-domains = <0x07 0x00>;
			clock-frequency = <0x65633340>;
			cpu-idle-states = <0x08 0x09 0x0a>;
			#cooling-cells = <0x02>;
			phandle = <0x0e>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x0b>;
				};

				core1 {
					cpu = <0x0c>;
				};

				core2 {
					cpu = <0x0d>;
				};

				core3 {
					cpu = <0x0e>;
				};
			};
		};

		idle-states {
			entry-method = "arm,psci";

			cpuoff_l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x10001>;
				local-timer-stop;
				entry-latency-us = <0x32>;
				exit-latency-us = <0x64>;
				min-residency-us = <0x640>;
				phandle = <0x08>;
			};

			clusteroff_l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010001>;
				local-timer-stop;
				entry-latency-us = <0x64>;
				exit-latency-us = <0xfa>;
				min-residency-us = <0x834>;
				phandle = <0x09>;
			};

			mcusysoff {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x1010002>;
				local-timer-stop;
				entry-latency-us = <0x1c2>;
				exit-latency-us = <0x258>;
				min-residency-us = <0xfa0>;
				phandle = <0x0a>;
			};
		};
	};

	/* stock boot DTB lines 197-336: mtk_lpm */
	mtk_lpm {
		compatible = "mediatek,mtk-lpm";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		suspend-method = "enable";
		logger-enable-states = "mcusysoff\0system_mem\0system_pll\0system_bus";
		mcusys-cnt-chk = <0x01>;
		irq-remain = <0x0f 0x10>;
		resource-ctrl = <0x11 0x12 0x13 0x14 0x15>;
		constraints = <0x16 0x17 0x18 0x19>;
		spm-cond = <0x1a 0x1b>;
		cg-shift = <0x00>;
		pll-shift = <0x10>;
		power-gs = <0x1c>;
		phandle = <0xb5>;

		cpupm-sysram@0011b000 {
			compatible = "mediatek,cpupm-sysram";
			reg = <0x00 0x11b000 0x00 0x500>;
			phandle = <0xb6>;
		};

		mcusys-ctrl@0c53a000 {
			compatible = "mediatek,mcusys-ctrl";
			reg = <0x00 0xc53a000 0x00 0x1000>;
			phandle = <0xb7>;
		};

		lpm_sysram@0011b500 {
			compatible = "mediatek,lpm-sysram";
			reg = <0x00 0x11b500 0x00 0x300>;
			phandle = <0xb8>;
		};

		irq-remain-list {

			edge_keypad {
				target = <0x1d>;
				value = <0x01 0x00 0x00 0x04>;
				phandle = <0x0f>;
			};

			edge_mdwdt {
				target = <0x1e>;
				value = <0x01 0x00 0x00 0x2000000>;
				phandle = <0x10>;
			};
		};

		resource-ctrl-list {

			bus26m {
				id = <0x00>;
				value = <0x00>;
				phandle = <0x11>;
			};

			infra {
				id = <0x01>;
				value = <0x00>;
				phandle = <0x12>;
			};

			syspll {
				id = <0x02>;
				value = <0x00>;
				phandle = <0x13>;
			};

			dram_s0 {
				id = <0x03>;
				value = <0x00>;
				phandle = <0x14>;
			};

			dram_s1 {
				id = <0x04>;
				value = <0x00>;
				phandle = <0x15>;
			};
		};

		constraint-list {

			rc_bus26m {
				rc-name = "bus26m";
				id = <0x00>;
				value = <0x01>;
				cond-info = <0x01>;
				phandle = <0x16>;
			};

			rc_syspll {
				rc-name = "syspll";
				id = <0x01>;
				value = <0x01>;
				cond-info = <0x01>;
				phandle = <0x17>;
			};

			rc_dram {
				rc-name = "dram";
				id = <0x02>;
				value = <0x01>;
				cond-info = <0x01>;
				phandle = <0x18>;
			};

			rc_cpu_buck_ldo {
				rc-name = "cpu-buck-ldo";
				id = <0x03>;
				value = <0x01>;
				cond-info = <0x00>;
				phandle = <0x19>;
			};
		};

		spm-cond-list {

			spm_cond_cg {
				cg-name = "MTCMOS_0\0MTCMOS_1\0INFRA_0\0INFRA_1\0INFRA_2\0INFRA_3\0INFRA_4\0INFRA_5\0PERI_0\0PERI_1\0PERI_2\0MMSYS_0";
				phandle = <0x1a>;
			};

			spm_cond_pll {
				pll-name = "UNIVPLL\0MFGPLL\0MSDCPLL\0MMPLL\0NET1PLL\0NET2PLL\0WEDMCUPLL\0MEDMCUPLL\0SGMIIPLL\0APLL1\0APLL2";
				phandle = <0x1b>;
			};
		};

		power-gs-list {

			gs_6361 {
				target = <0x1f>;
				value = "mediatek,mt6361-regulator";
				phandle = <0x1c>;
			};
		};
	};

	/* stock boot DTB lines 338-342: pmu */
	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupt-parent = <0x01>;
		interrupts = <0x01 0x07 0x04>;
	};

	/* stock boot DTB lines 344-348: dsu-pmu-0 */
	dsu-pmu-0 {
		compatible = "arm,dsu-pmu";
		interrupts = <0x00 0x12 0x04>;
		cpus = <0x0b 0x0c 0x0d 0x0e>;
	};

	/* stock boot DTB lines 350-355: performance-controller@0011bc00 */
	performance-controller@0011bc00 {
		compatible = "mediatek,cpufreq-hw";
		reg = <0x00 0x11bc10 0x00 0x120>;
		#performance-domain-cells = <0x01>;
		phandle = <0x07>;
	};

	/* stock boot DTB lines 357-365: dvfsp@0011bc00 */
	dvfsp@0011bc00 {
		compatible = "mediatek,mcupm-dvfsp";
		reg = <0x00 0x11bc00 0x00 0x1400>;
		nvmem = <0x20>;
		nvmem-names = "mtk_efuse";
		nvmem-cells = <0x21>;
		nvmem-cell-names = "efuse_segment_cell";
		phandle = <0xb9>;
	};

	/* stock boot DTB lines 367-382: leakage */
	leakage {
		compatible = "mediatek,mtk-static-power";
		nvmem = <0x20>;
		nvmem-names = "mtk_efuse";
		nvmem-cells = <0x21>;
		nvmem-cell-names = "efuse_segment_cell";
		n-domain = <0x07>;
		domain = "VPROC_L\0VCORE_OFF\0VCORE\0MODEM\0VSRAM_VPROC_L\0VSRAM_VCORE_PLUS_VLPAO\0VSRAM_MODEM";
		VPROC_L = <0x218 0xff0000 0x384 0x1e 0x01 0x00>;
		VCORE_OFF = <0x218 0xff00 0x2ee 0x1e 0x01 0x00>;
		VCORE = <0x218 0xff 0x2ee 0x1e 0x01 0x00>;
		MODEM = <0x21c 0xff 0x320 0x1e 0x01 0x00>;
		VSRAM_VPROC_L = <0x220 0xff000000 0x384 0x1e 0x01 0x00>;
		VSRAM_VCORE_PLUS_VLPAO = <0x220 0xff00 0x2ee 0x1e 0x01 0x00>;
		VSRAM_MODEM = <0x224 0xff 0x320 0x1e 0x01 0x00>;
	};

	/* stock boot DTB lines 384-429: lastbus */
	lastbus {
		compatible = "mediatek,lastbus";
		enabled = <0x01>;
		sw_version = <0x01>;
		timeout_ms = <0xc8>;
		timeout_type = <0x00>;
		phandle = <0xba>;

		monitors {

			monitor1 {
				monitor_name = "debug_ctrl_ao_INFRA_AO";
				base = <0x10030000>;
				num_ports = <0x5d>;
				bus_freq_mhz = <0x4e>;
			};

			monitor2 {
				monitor_name = "debug_ctrl_ao_PERI_AO";
				base = <0x10050000>;
				num_ports = <0x27>;
				bus_freq_mhz = <0x4e>;
			};

			monitor3 {
				monitor_name = "debug_ctrl_ao_PERI_AO2";
				base = <0x10051000>;
				num_ports = <0x10>;
				bus_freq_mhz = <0x4e>;
			};

			monitor4 {
				monitor_name = "debug_ctrl_ao_PERI_PAR_AO";
				base = <0x10052000>;
				num_ports = <0x0b>;
				bus_freq_mhz = <0x4e>;
			};

			monitor5 {
				monitor_name = "debug_ctrl_ao_FMEM_AO";
				base = <0x10033000>;
				num_ports = <0x12>;
				bus_freq_mhz = <0x4e>;
			};
		};
	};

	/* stock boot DTB lines 431-434: memory */
	memory {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x3e605000>;
	};

	/* stock boot DTB lines 498-502: pcie_mirror@10201000 */
	pcie_mirror@10201000 {
		compatible = "mediatek,pcie-mirror";
		reg = <0x00 0x10201000 0x00 0x1000>;
		phandle = <0xc3>;
	};

	/* stock boot DTB lines 504-550: reserved-memory */
	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0xc4>;

		gps-reserve-memory {
			compatible = "mediatek,gps-reserve-memory";
			no-map;
			size = <0x00 0x60000>;
			alignment = <0x00 0x10000>;
			alloc-ranges = <0x00 0x40000000 0x00 0x80000000>;
			phandle = <0x90>;
		};

		wocpu0_emi@A1BE0000 {
			compatible = "mediatek,wocpu0_emi";
			no-map;
			reg = <0x00 0xa1be0000 0x00 0x40000>;
			shared = <0x00>;
			phandle = <0xc5>;
		};

		wocpu1_emi@A1C20000 {
			compatible = "mediatek,wocpu1_emi";
			no-map;
			reg = <0x00 0xa1c20000 0x00 0x40000>;
			shared = <0x00>;
			phandle = <0xc6>;
		};

		wocpu2_emi@A1C60000 {
			compatible = "mediatek,wocpu2_emi";
			no-map;
			reg = <0x00 0xa1c60000 0x00 0x40000>;
			shared = <0x00>;
			phandle = <0xc7>;
		};

		wocpu_data@A30A0000 {
			compatible = "mediatek,wocpu_data";
			no-map;
			reg = <0x00 0xa30a0000 0x00 0xf00000>;
			shared = <0x01>;
			phandle = <0xc8>;
		};
	};

	/* stock boot DTB lines 552-556: cache_parity */
	cache_parity {
		compatible = "mediatek,mt6890-cache-parity";
		arm_dsu_ecc_hwirq = <0x20>;
		interrupts = <0x00 0x00 0x04 0x00 0x01 0x04 0x00 0x02 0x04 0x00 0x03 0x04 0x00 0x04 0x04>;
	};

	/* stock boot DTB lines 558-569: interrupt-controller */
	interrupt-controller {
		compatible = "arm,gic-v3";
		#interrupt-cells = <0x03>;
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		#redistributor-regions = <0x01>;
		interrupt-parent = <0x01>;
		interrupt-controller;
		reg = <0x00 0xc000000 0x00 0x40000 0x00 0xc040000 0x00 0x200000>;
		interrupts = <0x01 0x09 0x04>;
		phandle = <0x01>;
	};

	/* stock boot DTB lines 571-581: clkitg */
	clkitg {
		compatible = "simple-bus";
		scpsys = <0x23>;
		status = "okay";
		phandle = <0xc9>;

		bring-up {
			compatible = "mediatek,clk-bring-up";
			clocks = <0x24 0x11 0x24 0x3f 0x25 0x0c 0x24 0x20 0x26 0x00>;
		};
	};

	/* stock boot DTB lines 583-750: disable_unused */
	disable_unused {
		compatible = "simple-bus";
		status = "okay";
		phandle = <0xca>;

