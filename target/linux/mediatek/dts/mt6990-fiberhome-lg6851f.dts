	/*
	 * Stock boot DTB lines 2659-2676 use vendor-private key codes 6/7.
	 * Keep the exact board GPIOs, but translate their documented RESTORE/WPS
	 * functions to the standard Linux codes accepted by OpenWrt hotplug.
	 */
	gpio-keys {
		compatible = "gpio-keys";

		button0 {
			label = "RESTORE_KEY";
			gpios = <0x05 0x06 0x01>;
			linux,code = <KEY_RESTART>;
			linux,input-type = <0x01>;
		};

		button1 {
			label = "WPS_KEY";
			gpios = <0x05 0x01 0x01>;
			linux,code = <KEY_WPS_BUTTON>;
			linux,input-type = <0x01>;
			debounce-interval = <0x0a>;
		};
	};

