From: Xiang Mei <xmei5@asu.edu>
Subject: [PATCH] wifi: mac80211: fix FILS/unsolicited probe template double free

Backport upstream commits 1d067abcd370 and 286e52a799fa.  Publish the
replacement before queuing the old template for RCU freeing, so an
allocation failure cannot leave an already queued object reachable and
queue the same rcu_head a second time during a later Wi-Fi 7 reload.

--- a/net/mac80211/cfg.c
+++ b/net/mac80211/cfg.c
@@ -1120,9 +1120,6 @@ static int ieee80211_set_fils_discovery(
 	fd->max_interval = params->max_interval;
 
 	old = sdata_dereference(link->u.ap.fils_discovery, sdata);
-	if (old)
-		kfree_rcu(old, rcu_head);
-
 	if (params->tmpl && params->tmpl_len) {
 		new = kzalloc(sizeof(*new) + params->tmpl_len, GFP_KERNEL);
 		if (!new)
@@ -1134,6 +1131,9 @@ static int ieee80211_set_fils_discovery(
 		RCU_INIT_POINTER(link->u.ap.fils_discovery, NULL);
 	}
 
+	if (old)
+		kfree_rcu(old, rcu_head);
+
 	*changed |= BSS_CHANGED_FILS_DISCOVERY;
 	return 0;
 }
@@ -1156,8 +1156,6 @@ ieee80211_set_unsol_bcast_probe_resp(str
 	link_conf->unsol_bcast_probe_resp_interval = params->interval;
 
 	old = sdata_dereference(link->u.ap.unsol_bcast_probe_resp, sdata);
-	if (old)
-		kfree_rcu(old, rcu_head);
 
 	if (params->tmpl && params->tmpl_len) {
 		new = kzalloc(sizeof(*new) + params->tmpl_len, GFP_KERNEL);
@@ -1170,6 +1168,9 @@ ieee80211_set_unsol_bcast_probe_resp(str
 		RCU_INIT_POINTER(link->u.ap.unsol_bcast_probe_resp, NULL);
 	}
 
+	if (old)
+		kfree_rcu(old, rcu_head);
+
 	*changed |= BSS_CHANGED_UNSOL_BCAST_PROBE_RESP;
 	return 0;
 }
