--- a/mt7996/eeprom.c
+++ b/mt7996/eeprom.c
@@ -299,6 +299,39 @@ static int mt7996_eeprom_parse_band_config(struct mt7996_phy *phy)
 	return ret;
 }
 
+bool mt7996_band_valid(struct mt7996_dev *dev, u8 band)
+{
+	u8 *eeprom = dev->mt76.eeprom.data;
+	u8 val;
+
+	if (!is_mt7996(&dev->mt76))
+		return band <= MT_BAND1;
+
+	/* Before EEPROM is available, retain the hardware-wide assumption used
+	 * during early DMA setup.  Afterwards follow the SDK EEPROM selectors;
+	 * the MT7990 dual-band SKU deliberately uses PHY0 and PHY2.
+	 */
+	if (!eeprom)
+		return band <= MT_BAND2;
+
+	switch (band) {
+	case MT_BAND1:
+		val = FIELD_GET(MT_EE_WIFI_CONF1_BAND_SEL,
+				eeprom[MT_EE_WIFI_CONF]);
+		break;
+	case MT_BAND2:
+		val = FIELD_GET(MT_EE_WIFI_CONF2_BAND_SEL,
+				eeprom[MT_EE_WIFI_CONF + 1]);
+		break;
+	default:
+		val = FIELD_GET(MT_EE_WIFI_CONF0_BAND_SEL,
+				eeprom[MT_EE_WIFI_CONF]);
+		break;
+	}
+
+	return val != MT_EE_BAND_SEL_DEFAULT;
+}
