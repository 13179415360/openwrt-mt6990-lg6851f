#!/bin/sh /etc/rc.common

START=21
STOP=89
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/lg6851f-wifi-after-modem
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param term_timeout 5
	procd_close_instance
}

stop_service() {
	# This service owns boot ordering only.  Do not disable the user's saved
	# wireless configuration during shutdown.
	return 0
}
