#!/bin/sh /etc/rc.common

START=09
STOP=91

. /lib/functions/system.sh

: "${WIFI_EEPROM_SOURCE:=/mnt/vendor/nvcfg/e2p}"
: "${WIFI_EEPROM_TEMPLATE:=/rom/lib/firmware/mediatek/mt7996/mt7996_eeprom_mt6990.bin}"
: "${WIFI_EEPROM_ACTIVE:=/lib/firmware/mediatek/mt7996/mt7996_eeprom_mt6990.bin}"

log_msg() {
	logger -t lg6851f_modem_storage "$*"
	echo "lg6851f_modem_storage: $*"
}

link_gpt_partitions() {
	local uevent devname partname

	mkdir -p /dev/block
	for uevent in /sys/class/block/mmcblk0p*/uevent; do
		[ -r "$uevent" ] || continue
		devname=
		partname=
		while IFS='=' read -r key value; do
			case "$key" in
				DEVNAME) devname="$value" ;;
				PARTNAME) partname="$value" ;;
			esac
		done < "$uevent"
		[ -n "$devname" ] && [ -n "$partname" ] || continue
		ln -sf "/dev/$devname" "/dev/block/$partname"
	done
}

mount_part() {
	local device="$1"
	local target="$2"
	local attempt=1

	mkdir -p "$target"
	grep -qs " $target " /proc/mounts && return 0
	while [ "$attempt" -le 3 ]; do
		if mount -t ext4 -o noatime "$device" "$target"; then
			log_msg "mounted $device on $target (attempt $attempt)"
			return 0
		fi
		log_msg "WARN: failed to mount $device on $target (attempt $attempt)"
		attempt=$((attempt + 1))
		sleep 1
	done
	return 1
}

valid_unicast_mac() {
	local mac="$1"

	case "$mac" in
		""|00:00:00:00:00:00|ff:ff:ff:ff:ff:ff|[13579bdf]:*) return 1 ;;
	esac
	return 0
}

prepare_wifi_eeprom() {
	local dir tmp source_mac0 source_mac1 active_mac0 active_mac1

	[ -f "$WIFI_EEPROM_TEMPLATE" ] || {
		log_msg "ERROR: immutable MT7990 EEPROM template is missing"
		return 1
	}
	[ "$(wc -c < "$WIFI_EEPROM_TEMPLATE")" -eq 7680 ] || {
		log_msg "ERROR: immutable MT7990 EEPROM template has invalid size"
		return 1
	}
	[ "$(hexdump -v -n 2 -e '2/1 "%02x"' "$WIFI_EEPROM_TEMPLATE")" = "9079" ] || {
		log_msg "ERROR: immutable MT7990 EEPROM template has invalid chip ID"
		return 1
	}

	dir="${WIFI_EEPROM_ACTIVE%/*}"
	mkdir -p "$dir"
	tmp="$(mktemp "$dir/.mt7990-eeprom.XXXXXX")" || return 1
	if ! cp "$WIFI_EEPROM_TEMPLATE" "$tmp"; then
		rm -f "$tmp"
		return 1
	fi

	if [ -f "$WIFI_EEPROM_SOURCE" ] &&
	   [ "$(wc -c < "$WIFI_EEPROM_SOURCE")" -eq 7680 ] &&
	   [ "$(hexdump -v -n 2 -e '2/1 "%02x"' "$WIFI_EEPROM_SOURCE")" = "9079" ]; then
		source_mac0="$(get_mac_binary "$WIFI_EEPROM_SOURCE" 4)"
		source_mac1="$(get_mac_binary "$WIFI_EEPROM_SOURCE" 10)"
		if valid_unicast_mac "$source_mac0" && valid_unicast_mac "$source_mac1"; then
			if dd if="$WIFI_EEPROM_SOURCE" of="$tmp" bs=1 skip=4 seek=4 \
				count=12 conv=notrunc 2>/dev/null; then
				active_mac0="$(get_mac_binary "$tmp" 4)"
				active_mac1="$(get_mac_binary "$tmp" 10)"
				if [ "$active_mac0" = "$source_mac0" ] &&
				   [ "$active_mac1" = "$source_mac1" ]; then
					log_msg "using validated device MT7990 MAC slots $active_mac0/$active_mac1"
				else
					cp "$WIFI_EEPROM_TEMPLATE" "$tmp"
					log_msg "WARN: MT7990 MAC copy verification failed; using SDK template"
				fi
			else
				cp "$WIFI_EEPROM_TEMPLATE" "$tmp"
				log_msg "WARN: cannot copy MT7990 MAC slots; using SDK template"
			fi
		else
			log_msg "WARN: device MT7990 MAC slots are invalid; using SDK template"
		fi
	else
		log_msg "WARN: device MT7990 EEPROM is unavailable or invalid; using SDK template"
	fi

	chmod 0644 "$tmp"
	mv -f "$tmp" "$WIFI_EEPROM_ACTIVE"
}

start() {
	local slot

	link_gpt_partitions
	slot="$(sed -n 's/.*bootslot=\([^ ]*\).*/\1/p' /proc/cmdline)"
	case "$slot" in
		a|b) ;;
		*) slot=b ;;
	esac

	# Vendor userspace was built without Android property support and opens
	# slot-independent names such as /dev/block/md1img.  Reproduce the
	# official setup_link mapping for every A/B partition used by the stack.
	for part in connsys_gnss mcf1 mcf2 md1img md1dsp spmfw pi_img dpm \
		medmcu sspm mcupm lk tee boot rootfs; do
		[ -e "/dev/block/${part}_$slot" ] || continue
		ln -sf "/dev/block/${part}_$slot" "/dev/block/$part"
	done

	mkdir -p /mnt/vendor/nvcfg /mnt/vendor/nvdata
	mkdir -p /mnt/vendor/protect_f /mnt/vendor/protect_s
	mkdir -p /mnt/vendor/mdota /mnt/vendor/mdota2 /mnt/vendor/mdlpm /vendor
	[ -e /vendor/firmware ] || ln -s /etc/firmware /vendor/firmware
	[ -e /vendor/etc ] || ln -s /etc /vendor/etc

	mount_part /dev/block/nvcfg /mnt/vendor/nvcfg
	prepare_wifi_eeprom || log_msg "ERROR: failed to prepare MT7990 EEPROM"
	mount_part /dev/block/nvdata /mnt/vendor/nvdata
	mount_part /dev/block/protect1 /mnt/vendor/protect_f
	mount_part /dev/block/protect2 /mnt/vendor/protect_s
	mount_part /dev/block/mcf1 /mnt/vendor/mdota
	mount_part /dev/block/mcf2 /mnt/vendor/mdota2

	# NVRAM is the hard prerequisite for MD boot.  A failure of an optional
	# FSD partition must not suppress nvram_daemon after nvdata is available.
	if ! grep -qs ' /mnt/vendor/nvdata ' /proc/mounts; then
		log_msg "ERROR: nvdata is unavailable; modem boot is unsafe"
		return 1
	fi
	mkdir -p /mnt/vendor/nvdata/md_cmn
	log_msg "official modem storage setup complete, slot=$slot"
}

stop() {
	:
}
