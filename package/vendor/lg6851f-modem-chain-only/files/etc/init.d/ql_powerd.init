#!/bin/sh /etc/rc.common

START=13

STOP=01

USE_PROCD=1
NAME=ql_powerd


start_service() 
{
	echo "start ql_powerd"
	procd_open_instance ql_powerd
	procd_set_param command /usr/bin/ql_powerd
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() 
{
    echo "stop ql_powerd"
}

reload_service() 
{
    echo "reload ql_powerd"
    stop
    start
}
