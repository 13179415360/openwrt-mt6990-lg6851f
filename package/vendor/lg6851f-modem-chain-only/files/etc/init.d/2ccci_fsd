#!/bin/sh /etc/rc.common

START=11
STOP=48

USE_PROCD=1
NAME=ccci_fsd
PROG=/usr/bin/ccci_fsd

start_service() {
	echo "start ccci_fsd"
	procd_open_instance ccci_fsd
	procd_set_param command /usr/bin/ccci_fsd 0 0 100
	procd_set_param respawn 20 5 100
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param nice -20
	procd_close_instance
}
