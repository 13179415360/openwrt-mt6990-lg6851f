#!/bin/sh /etc/rc.common

START=22

USE_PROCD=1

start_service() {
	echo "start netagent"

	procd_open_instance
	procd_set_param command /usr/bin/mtk_netagent
	procd_set_param watch modem_reset
	procd_set_param respawn 20 5 100
	# forward stdout and stderr of the command to logd
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	echo "netagent reload_service"
	stop
	start
}
