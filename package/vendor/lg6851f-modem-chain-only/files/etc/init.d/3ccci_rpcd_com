#!/bin/sh /etc/rc.common

START=13
STOP=50

USE_PROCD=1
NAME=ccci_rpcd_com
PROG=/usr/bin/ccci_rpcd_com

start_service() {
	echo "start ccci_rpcd_com"
	procd_open_instance ccci_rpcd_com
	procd_set_param command /usr/bin/ccci_rpcd_com 0
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param nice -20
	procd_close_instance
}
