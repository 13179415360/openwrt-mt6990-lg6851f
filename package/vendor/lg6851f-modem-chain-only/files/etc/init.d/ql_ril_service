#!/bin/sh /etc/rc.common

START=85

STOP=15

USE_PROCD=1
NAME=ql_ril_service


start_service() 
{
	echo "start ql_ril_service daemon process"
	procd_open_instance ql_ril_service
	procd_set_param command /usr/bin/ql_ril_service
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() 
{
    echo "stop ql_ril_service daemon process"
    set_state shutdown
}

reload_service() 
{
    echo "reload ql_ril_service daemon process"
    stop
    start
}
