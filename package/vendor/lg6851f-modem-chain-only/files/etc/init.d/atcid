#!/bin/sh /etc/rc.common

START=96
#STOP=48

USE_PROCD=1
NAME=atcid

start_service() {
	echo "start atcid"

	procd_open_instance main
	procd_set_param command /usr/bin/atcid
	procd_set_param limits core="unlimited"
	procd_set_param respawn
	# forward stdout and stderr of the command to logd
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

	# The modem can return CNMI to its factory-disabled value after power loss.
	# Run the idempotent SMS setup after every atcid service start.  The helper
	# uses modem5g-at, so it shares the same bounded serial lock as LuCI/status.
	procd_open_instance sms-init
	procd_set_param command /usr/sbin/lg6851f-sms-init
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service()
{
	echo "atcid reload_service"

	stop
	start
}
