#!/bin/sh /etc/rc.common

START=10

USE_PROCD=1
NAME=nvram_daemon
PROG=/usr/bin/nvram_daemon

start_service() {
	if ! grep -qs ' /mnt/vendor/nvdata ' /proc/mounts || [ ! -e /dev/block/nvram ]; then
		echo "nvram_daemon: modem storage is not ready"
		return 1
	fi
	echo "start nvram_daemon"
	procd_open_instance nvram_daemon
	procd_set_param command /usr/bin/nvram_daemon
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance

}
