#!/bin/sh

SERVICE=lg6851f-network-led
STATE=/tmp/lg6851f-network-led.state
LEDS='lg6851f:wifi lg6851f:4g-good lg6851f:4g-fair lg6851f:4g-bad lg6851f:5g-bad lg6851f:5g-fair lg6851f:5g-good'

all_off() {
	local led
	for led in $LEDS; do
		[ -w "/sys/class/leds/$led/brightness" ] && echo 0 >"/sys/class/leds/$led/brightness"
	done
}

case "${1:-status}" in
	start|stop|restart)
		/etc/init.d/$SERVICE "$1"
		;;
	off)
		all_off
		;;
	status)
		/etc/init.d/$SERVICE status
		[ ! -r "$STATE" ] || cat "$STATE"
		;;
	log)
		logread | grep 'lg6851f-network-led' | tail -n "${2:-100}"
		;;
	*)
		echo "Usage: $0 {start|stop|restart|off|status|log [lines]}" >&2
		exit 2
		;;
esac
